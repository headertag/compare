telegram:
  token: "YOUR_TELEGRAM_BOT_TOKEN"
  chat_ids:
    - 123456789 # Example chat ID 1
    - 987654321 # Example chat ID 2

alerting:
  cooldown_seconds: 120
  cooldown_threshold_multiplier: 2
  min_interval_seconds: 5
  sensitivity_threshold: 2.3

camera:
  # default is /dev/video0
  index: 0
  #index: "your-sample-video.mp4" # this will also work in place of a physical device
  width: 1920
  height: 1080

processing:
  device: "cpu" # "cuda" or "cpu"
  coco_classes_path: "coco_classes.pickle"
  execution_mode: "sequential" # "sequential" (for embedded/Tegra) or "parallel" (for high-end discrete GPUs)
  inter_frame_delay: 0.1 # seconds (thermal yield sleep between frames, default 0.1s; set to 0 for max throughput)

models:
  # Dynamic N-Models configuration: add, remove, enable/disable any model!
  # Available types: "detr", "yolos", "torchvision", "yolov5", "rf_detr"
  detr_resnet_50:
    type: "detr"
    name: "facebook/detr-resnet-50"
    enabled: true
    confidence_threshold: 0.9
    weight: 0.5
    color: [0, 0, 255] # BGR color for bounding boxes
  yolos_tiny:
    type: "yolos"
    name: "hustvl/yolos-tiny"
    enabled: true
    confidence_threshold: 0.9
    weight: 0.5
    color: [255, 100, 0]
  frcnn_resnet:
    type: "torchvision"
    name: "frcnn-resnet"
    enabled: true
    confidence_threshold: 0.8
    weight: 1.0
    color: [0, 255, 255]
  retinanet:
    type: "torchvision"
    name: "retinanet"
    enabled: true
    confidence_threshold: 0.6
    weight: 1.0
    color: [255, 0, 255]
  yolov5s:
    type: "yolov5"
    name: "yolov5s"
    enabled: true
    confidence_threshold: 0.6
    weight: 1.0
    color: [0, 165, 255]
  rf_detr_base:
    type: "rf_detr"
    name: "Roboflow/rf-detr-base"
    enabled: false # Set true to enable Roboflow RF-DETR transformer model
    confidence_threshold: 0.5
    weight: 0.5
    color: [180, 105, 255]
  yolo11m:
    type: "ultralytics"
    name: "yolo11m.pt" # Options: yolo11n.pt (Nano), yolo11s.pt (Small), yolo11m.pt (Medium 20.1M params, ~51.5 mAP)
    enabled: false # Set true to enable 2024 SOTA YOLO11 Medium
    confidence_threshold: 0.5
    weight: 0.5
    color: [50, 205, 50]
  rtdetr_large:
    type: "ultralytics"
    name: "rtdetr-l.pt" # Real-time DETR transformer (32.1M params, ~53.1 mAP)
    enabled: false
    confidence_threshold: 0.5
    weight: 0.5
    color: [255, 20, 147]

dashboard:
  remove_background: false

# Trajectory evidence is opt-in; use min_movement_frames: 3 for a 3x3 camera wall.
tracking:
  rows: 3
  columns: 3
  min_movement_frames: 0 # 0 completely bypasses tracking/grid/boost (legacy behavior)
  score_multiplier: 1.5 # Qualified model vote = confidence * model weight * this
  movement_pixels: 2.0 # Minimum observed center displacement per processed frame
  movement_box_fraction: 0.01 # Also require > this fraction of the box diagonal
  low_threshold: 0.1 # Candidate floor BEFORE tracking; low scores can extend tracks
  high_threshold: 0.4 # Minimum confidence to start or recover a lost track
  match_iou: 0.2 # Minimum IoU for Kalman prediction / high-score Hungarian matching
  low_match_iou: 0.3 # Minimum IoU in the second (low-score) association stage
  max_lost_frames: 15 # Retain an unmatched identity this many processed frames
  history_frames: 60 # Maximum observed boxes retained per track
  reset_gap_seconds: 5.0 # Clear history after a processing/camera interruption
  draw_history: true
